{
	default_sni {$APP_PUBLIC_IP}
}

# Keep the static IP available for health checks and domain migration.
{$APP_PUBLIC_IP} {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}
	encode zstd gzip
	reverse_proxy nginx:80
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
